{
  "name": "@anneal/desktop",
  "version": "0.1.0",
  "private": true,
  "description": "Anneal Workbench: generate, review and publish study decks",
  "author": "Anneal contributors",
  "license": "MIT",
  "main": "dist/main/main.cjs",
  "scripts": {
    "build:main": "node scripts/build-main.mjs",
    "build:renderer": "vite build",
    "build": "pnpm build:main && pnpm build:renderer",
    "start": "pnpm build && electron .",
    "dev": "node scripts/dev.mjs",
    "dist": "pnpm build && electron-builder --win --publish never",
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.json && tsc -p tsconfig.main.json"
  },
  "devDependencies": {
    "@anneal/core": "workspace:*",
    "@anneal/workbench": "workspace:*",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "electron": "^44.9.0",
    "electron-builder": "^26.15.3",
    "esbuild": "^0.28.2",
    "jsdom": "^30.1.3",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "typescript": "^7.0.2",
    "vite": "^8.3.4",
    "vitest": "^5.0.3"
  },
  "build": {
    "appId": "org.anneal.workbench",
    "productName": "Anneal Workbench",
    "directories": { "output": "release" },
    "files": ["dist/**", "package.json"],
    "win": { "target": "nsis" },
    "nsis": { "oneClick": false, "allowToChangeInstallationDirectory": true }
  }
}
